# ==============================================================================
# AI STYLIST — COMPLETE ENVIRONMENT VARIABLES CONFIGURATION
# ==============================================================================
# Copy this file to `backend/.env` for local development.
# For Vercel production deployment, add these in Project Settings -> Environment Variables.

# ------------------------------------------------------------------------------
# 1. CORE SERVER & NETWORKING
# ------------------------------------------------------------------------------
# Host interface to bind to (0.0.0.0 listens on all interfaces)
HOST=0.0.0.0

# Backend port
PORT=8000

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Secret key used for signing JWT authentication tokens (generate a 32+ char random string)
SECRET_KEY=ai_stylist_super_secret_jwt_key_2026_fashion_harmony

# JWT signing algorithm (HS256 recommended)
ALGORITHM=HS256

# Access token lifespan in minutes (10080 = 7 days)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ------------------------------------------------------------------------------
# 3. DATABASE & STORAGE
# ------------------------------------------------------------------------------
# Database connection string.
# Local Windows PC default: sqlite:///./ai_stylist.db
# Vercel / Serverless: Automatically routed to /tmp/ai_stylist/ai_stylist.db
# Production Cloud DB (Optional): postgresql://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./ai_stylist.db

# Base directory for user uploads and temporary images
# (On Vercel, automatically directed to /tmp/ai_stylist/uploads)
UPLOAD_DIR=uploads

# ------------------------------------------------------------------------------
# 4. GOOGLE GEMINI VISION (SEMANTIC GARMENT & STYLE REASONING)
# ------------------------------------------------------------------------------
# Enable or disable Gemini multimodal vision analysis
GEMINI_ENABLED=true

# Google AI Studio / Gemini API Key (Get from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model name
GEMINI_MODEL=gemini-3.6-flash

# API timeout in seconds
GEMINI_TIMEOUT=15

# ------------------------------------------------------------------------------
# 5. OUTFIT VISUAL RECOMMENDATION ENGINE
# ------------------------------------------------------------------------------
# Visual mode: 'ai' (photorealistic images) or 'pillow' (infographic compositor)
OUTFIT_VISUAL_PROVIDER=ai

# AI Provider:
# - 'pollinations' (Instant free photorealistic Flux generation, no key required)
# - 'openai' (DALL-E 3, requires IMAGE_GENERATION_API_KEY)
# - 'stability' (Stable Diffusion, requires IMAGE_GENERATION_API_KEY)
AI_IMAGE_PROVIDER=pollinations

# API Key for OpenAI / Stability (Leave blank when using pollinations)
IMAGE_GENERATION_API_KEY=

# Diffusion model identifier
AI_IMAGE_MODEL=flux

# Request timeout in seconds
AI_IMAGE_TIMEOUT=35

# ------------------------------------------------------------------------------
# 6. VIRTUAL TRY-ON (VTON) ENGINE
# ------------------------------------------------------------------------------
# VTON Provider mode:
# - 'local'    : Runs FASHN VTON v1.5 with PyTorch & CUDA on local NVIDIA GPU (RTX 3050+)
# - 'disabled' : Used on serverless / Vercel without GPU; provides complete styling & material guides
VTON_PROVIDER=local

# Master switch for virtual try-on processing
VTON_ENABLED=true

# Try-on model identifier
VTON_MODEL_NAME=FASHN VTON v1.5

# Number of photorealistic try-on looks to generate before complete outfit combinations (Default: 2)
TRYON_MAX_LOOKS=2
